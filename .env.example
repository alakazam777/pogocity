# ── PogoCity environment variables ──────────────────────────
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit your real secrets.

# PogoSphere — local development configuration
# Shares the same database (data/) as PogoPoitiers via POGO_DATA_DIR in ecosystem.config.js

NEXTAUTH_URL=



# Apple Sign In



APPLE_ID=



APPLE_TEAM_ID=



APPLE_KEY_ID=



APPLE_PRIVATE_KEY=

# Reuse the same NextAuth secret so sessions/JWT are compatible with shared user data
NEXTAUTH_SECRET=

# Discord OAuth — same app (users log in with same Discord accounts)
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Admin
ADMIN_TOKEN=
ADMIN_PASSWORD=
DISCORD_ADMIN_ID=

# Google Vision OCR (shared quota)
GOOGLE_VISION_API_KEY=

# Discord bot (admin)
DISCORD_BOT_TOKEN_ADMIN=

# Webhooks
# DISCORD_TRADE_WEBHOOK_URL is intentionally DIFFERENT from PogoPoitiers'
# webhook — the original pogopoitiers/.env.local points at channel
# 1485015961387008132 (which is the PoPo trade-hall channel). For
# PogoSphere we route to a dedicated PogoSphere Discord channel
# (1503450053694590987) so the cross-pollinated user base only sees the
# trades relevant to their community on each site.
DISCORD_TRADE_WEBHOOK_URL=
BUG_REPORT_WEBHOOK_URL=
DISCORD_CAMPFIRE_ANNOUNCE_WEBHOOK_URL=
DISCORD_CAMPFIRE_ANNOUNCE_CHANNEL_ID=

# pm2 process name — used by the admin Rebuild button.
PM2_APP_NAME=

# Last.fm API key — optional (music feature). A public default is used if unset.
LASTFM_API_KEY=
