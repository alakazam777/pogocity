# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore real env files, but COMMIT .env.example (the template)
.env*
!.env.example
.env.local
.env.production
.env.local.bak

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data and uploads
data/pokemon_users.json
data/hidden_presentations.json
data/presentation_overrides.json
data/community_suggestions.json
data/events.json
data/reports.json
data/blocks.json
public/uploads/.claude/worktrees/
.claude/launch.json
# Claude Code worktrees — temporary scratch dirs, never tracked as a submodule
.claude/worktrees/

# binaries (cloudflared.exe is ~68 MB, exceeds GitHub blob limit anyway)
*.exe

# build artifacts
build_log.txt
build_output.log
*.log

# deployment bundles & temp scripts (regenerated, not source-of-truth)
deployment_bundle/
deployment_bundle.zip
tmp/
*.tar.gz
*.zip
public/uploads/

# pokemon manager — per-user runtime state, not source-controlled
data/.vision-quota.json
data/collections/

# auto-generated rolling backups from src/lib/safeJsonStore.js
data/backups/

# zero-downtime deploy: staging + last-known-good build dirs
/.next.staging/
/.next.old/
/.next.test/

# Capacitor web build output (regenerated by `npx cap copy`)

# Capacitor / Android — commit the project, ignore generated build outputs + secrets
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/app/release/
android/app/debug/
android/local.properties
android/keystore.properties
android/key.properties
android/captures/
android/.cxx/
android/app/src/main/assets/capacitor.plugins.json
# Keystore files — NEVER commit these (private signing key)
*.keystore
*.jks
upload-keystore.*
release-keystore.*

# Capacitor / iOS — commit the project, ignore Xcode build outputs + user state
ios/App/build/
ios/App/DerivedData/
ios/App/Pods/
ios/App/App/public/
ios/App/App/capacitor.config.json
# Xcode user-specific files
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
# Provisioning profiles & certificates (machine-specific)
*.mobileprovision
*.provisionprofile

# (src/lib/pogo-shared/ holds shared i18n code — committed with the repo)
